    | EssenceValue
  EssenceValue = Number
    | Rating
  Rating = "{Rating}" | "Rating"
  Number = "-" PositiveNumber -- negative
    | PositiveNumber
  PositiveNumber = digit+ "." digit+ -- float
    | digit+ -- int
