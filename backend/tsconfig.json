{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // allow top level await for models
    "target": "ES2022",
    "rootDir": "./src",
    "outDir": "./build",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "src/tests", "src/scripts"],
  "references": [
    {
      "path": "../common"
    },
    {
      "path": "../database"
    }
  ],
  "dependencies": {
    "@neon-codex/database": "workspace:^"
  }
}
