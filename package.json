{
  "name": "neon-codex",
  "workspaces": [
    "frontend",
    "backend",
    "common",
    "database",
    "converter"
  ],
  "scripts": {
    "build": "npm run build-backend && npm run build-frontend ",
    "build-backend": "npm run build -w backend",
    "build-frontend": "npm run build-dev -w frontend",
    "serve-backend": "npm run dev -w backend",
    "sb": "npm run serve-backend",
    "serve-frontend": "npm run serve -w frontend",
    "sf": "npm run serve-frontend",
    "watch-frontend": "npm start -w frontend",
    "wf": "npm run watch-frontend",
    "watch-backend": "npm run watch -w backend",
    "wb": "npm run watch-backend",
    "test": "npm test -w frontend && npm test -w backend",
    "check-equipment-version": "tsx backend/src/scripts/check-equipment-version.ts",
    "check-creator-data-version": "tsx backend/src/scripts/check-creator-data-version.ts",
    "prestart": "npm run check-equipment-version && npm run check-creator-data-version && npm run build -w backend && npm run build-dev -w frontend",
    "start": "npm run dev -w backend",
    "start-prod": "npm run build -w backend && npm run build -w frontend && npm start -w backend",
    "clean": "npm run clean -w frontend -w common -w backend -w database -w converter",
    "prepare": "husky install",
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "generate-equipment": "cross-env NODE_ENV=development tsx backend/src/scripts/generate-equipment-json.ts",
    "generate-creator-data": "cross-env NODE_ENV=development tsx backend/src/scripts/generate-creator-data-json.ts",
    "setup": "npm run generate-equipment && npm run generate-creator-data"
  },
  "private": true,
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.56.1",
    "@types/mini-css-extract-plugin": "^2.5.1",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-sonarjs": "^1.0.3",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.3",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "tsx": "^4.20.3"
  },
  "dependencies": {
    "eslint-plugin-no-excess-properties": "file:../eslint"
  }
}
